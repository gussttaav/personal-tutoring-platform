                  import difflib
                  from pathlib import Path
                  
                  RECETAS = Path(__file__).with_name("recetas.txt")
                  
                  
                  def es_comentario(linea):
                      """Una línea que no es una receta: un comentario."""
                      return linea.lstrip().startswith("#")
                  
                  
                  def separar(receta):
