  →  observación  # La despensa de casa: qué hay, cuánto y hasta cuándo se puede comer.
                  #
                  # Cada línea de la despensa es un artículo: nombre; cantidad; fecha de caducidad, con la
                  # fecha como en el calendario, año-mes-día. Una línea vacía o que empieza por # no es un
                  # artículo.
                  from fechas import fecha
                  
                  
                  def articulo(linea):
                      # 'arroz; 2; 2026-11-20' -> {'nombre': 'arroz', 'cantidad': 2, 'caduca': date(2026, 11, 20)}
                      nombre, cantidad, caduca = (parte.strip() for parte in linea.split(';'))
                      return {'nombre': nombre, 'cantidad': int(cantidad), 'caduca': fecha(caduca)}
                  
                  
                  def leer_despensa(texto):
                      # Todas las líneas que son artículos, en el orden en que están.
                      articulos = []
                      for linea in texto.splitlines():
                          linea = linea.strip()
                          if linea and not linea.startswith('#'):
                              articulos.append(articulo(linea))
                      return articulos
                  
                  
                  def cantidad(despensa, nombre):
                      # Cuántos hay de un artículo, sumando todas sus líneas: puede haber dos paquetes de arroz.
                      return sum(a['cantidad'] for a in despensa if a['nombre'] == nombre)
                  
                  
                  def gastar(despensa, nombre, cuantos):
                      # Quita cuantos del artículo, empezando por el que caduca antes. Devuelve la despensa
                      # sin los artículos que se han acabado.
                      if cantidad(despensa, nombre) < cuantos:
                          raise ValueError('no hay %d de %s' % (cuantos, nombre))
                      for a in sorted((a for a in despensa if a['nombre'] == nombre), key=lambda a: a['caduca']):
                          quito = min(a['cantidad'], cuantos)
                          a['cantidad'] -= quito
                          cuantos -= quito
                      return [a for a in despensa if a['cantidad'] > 0]
turno 6  503 s  2491 tokens de entrada
  ←  texto        El error está en `gastar` porque no se está ordenando correctamente los artículos por fecha de caducidad. La función `gastar` debe ordenar los artículos por fecha de caducidad antes de comenzar a gastar. Sin embargo, en `despensa.py`, la línea `sorted((a for a in despensa if a['nombre'] == nombre), key=lambda a: a['caduca'])` está mal porque `a['caduca']` es un objeto `date`, y `sorted` lo ordena correctamente, pero el uso de `key=lambda a: a['caduca']` no está aplicado correctamente en el contexto del ordenamiento. Se debe corregir para que se ordene correctamente por fecha de caducidad. Además, hay que asegurarse de que el ordenamiento sea por fecha, y que se esté procesando correctamente. Voy a modificar `gastar` para que ordene correctamente por fecha de caducidad. ```python def gastar(despensa, nombre, cuantos): # Quita cuantos del artículo, empezando por el que caduca antes. Devuelve la despensa # sin los artículos que se han acabado. if cantidad(despensa, nombre) < cuantos: raise ValueError('no hay %d de %s' % (cuantos, nombre)) # Ordenar por fecha de caducidad (más temprana primero) artículos = sorted((a for a in despensa if a['nombre'] == nombre), key=lambda a: a['caduca']) for a in artículos: quito = min(a['cantidad'], cuantos) a['cantidad'] -= quito cuantos -= quito return [a for a in despensa if a['cantidad'] > 0] ``` Ahora, aplico el cambio directamente en el archivo. ```json { "name": "editar", "arguments": { "ruta": "despensa.py", "antiguo": " for a in sorted((a for a in despensa if a['nombre'] == nombre), key=lambda a: a['caduca']):\n quito = min(a['cantidad'], cuantos)\n a['cantidad'] -= quito\n cuantos -= quito\n return [a for a in despensa if a['cantidad'] > 0]", "nuevo": " artículos = sorted((a for a in despensa if a['nombre'] == nombre), key=lambda a: a['caduca'])\n for a in artículos:\n quito = min(a['cantidad'], cuantos)\n a['cantidad'] -= quito\n cuantos -= quito\n return [a for a in despensa if a['cantidad'] > 0]" } } ``` Luego, ejecuto los tests para verificar que pasen. ```json { "name": "ejecutar", "arguments": { "comando": "python3 -m unittest" } } ``` Una vez que los tests pasen, se confirmará que el error ha sido corregido.
